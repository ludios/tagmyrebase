#!/usr/bin/env python3

"""
Utility to mark the HEAD with a branch and timestamped tag, and the upstream
commit (that we're rebased on top of) with another timestamped tag.

This allows you to

1) easily find an older set of rebased patches with `git tag`
2) see in tig/gitk which commits you've previously rebased onto.  This is
   useful for seeing which new commits you might need to review.

Sample usage:
git pull --rebase
tagmyrebase --tag-upstream "U-{YMDN}" --tag-head "good-{YMDN}" --branch-head good

All three arguments are optional.

For any of --tag-upstream, --tag-head, and --branch-head, you can use {YMDHMS}
to insert the current time, or {YMDN} to insert the current date with a
counter that avoids collision with existing tags.  Note that the {YMDHMS} or
{YMDN} will not necessarily correspond on the HEAD and upstream commits.
"""

__version__ = "3.2.0"

import argparse
import datetime
import re
import subprocess
import sys
from collections.abc import Iterator, Sequence
from dataclasses import dataclass
from typing import TextIO


def get_re_for_format_string(format_string: str) -> re.Pattern[str]:
	"""
	Returns a regular expression for a format string, so that we can check
	if a tag already exists.
	"""
	YMDHMS_RE = r"\d\d\d\d-[01]\d-[0-3]\d_[0-2]\d-[0-5]\d-[0-6]\d"
	YMDN_RE   = r"\d\d\d\d-[01]\d-[0-3]\d\.\d+"
	return re.compile(
		r"\A" +
		format_string
			.replace("{YMDHMS}", YMDHMS_RE)
			.replace("{YMDN}", YMDN_RE) +
		r"\Z")


_message_cache: dict[str, str] = {}

def get_commit_with_message(commit: str) -> str:
	if commit in _message_cache:
		return _message_cache[commit]
	message = subprocess.check_output([
		"git",  "log", "--format=oneline", "--max-count=1", commit
	], encoding="utf-8").rstrip("\r\n")
	_message_cache[commit] = message
	return message


def get_current_branch() -> str | None:
	"""
	Return the name of the current branch (without "refs/heads/"), or None if
	HEAD is detached.
	"""
	branch = subprocess.check_output([
		"git", "branch", "--show-current"
	], encoding="utf-8").rstrip("\r\n")
	return branch or None


@dataclass(frozen=True)
class Refs:
	"""
	The full hashes that HEAD, the local branches, and the tags point to.
	"""
	tags:  dict[str, str]
	"""
	Maps each tag name to the hash of the object that the tag points to.  For
	an annotated tag, that is the object (usually a commit) that the tag object
	points to, not the tag object itself.
	"""
	heads: dict[str, str]
	"""Maps each local branch name to the commit that the branch points to."""
	head:  str
	"""The commit that HEAD points to."""


class NoHeadCommit(Exception):
	pass


def get_refs() -> Refs:
	"""
	Raise NoHeadCommit if HEAD doesn't point to a commit.
	"""
	stdout = subprocess.check_output([
		"git", "show-ref", "--head", "--dereference"
	], encoding="utf-8")
	lines  = stdout.replace("\r", "").strip("\n").split("\n")
	DEREF  = "^{}"
	tags:  dict[str, str] = {}
	heads: dict[str, str] = {}
	head:  str | None     = None
	for line in lines:
		commit, ref = line.split(" ", 1)
		if ref.startswith("refs/tags/"):
			# For the old heavyweight tags, use the dereference line ending with ^{}
			# which point to the correct commit. `git show-ref --head --dereference`
			# prints ^{} line after the tag line, so the wrong commit will be replaced
			# with correct commit.
			#
			# For the new lightweight tags, there is no dereference line, but the tag
			# itself points to the correct commit.
			tag = ref.replace("refs/tags/", "", 1)
			tag = tag.removesuffix(DEREF)
			tags[tag] = commit
		elif ref.startswith("refs/heads/"):
			heads[ref.replace("refs/heads/", "", 1)] = commit
		elif ref == "HEAD":
			head = commit
		# We don't need remotes
	if head is None:
		raise NoHeadCommit("HEAD does not point to a commit, because the current branch has no commits yet")
	return Refs(tags=tags, heads=heads, head=head)


def get_keys_for_value(d: dict[str, str], value: str) -> list[str]:
	KEY   = 0
	VALUE = 1
	return [t[KEY] for t in d.items() if t[VALUE] == value]


def get_expanded_name(format_string: str, t: datetime.datetime, refs: Refs) -> str:
	ymdn: str | None = None
	if "{YMDN}" in format_string:
		ymd = t.strftime("%Y-%m-%d")
		for n in range(1, 100000):
			proposed_ymdn = ymd + "." + str(n)
			proposed_tag = get_expanded_name(
				format_string.format(
					YMDN=proposed_ymdn,
					YMDHMS="{YMDHMS}"
				), t, refs)
			if not proposed_tag in refs.tags:
				ymdn = proposed_ymdn
				break
		else:
			raise RuntimeError("100,000 tags in one day is too many tags")

	return format_string.format(
		YMDN=ymdn,
		YMDHMS=t.strftime("%Y-%m-%d_%H-%M-%S")
	)


class UnknownUpstream(Exception):
	pass


class NoCommonAncestor(Exception):
	pass


def merge_base_with_upstream(*options: str) -> str | None:
	"""
	Run `git merge-base OPTIONS @{upstream} HEAD`, where OPTIONS are extra
	options for `git merge-base`, such as "--fork-point".

	Return the full hash of the commit that git prints, or None if git finds
	no such commit (exit status 1).  Raise UnknownUpstream if git can't
	resolve @{upstream} (exit status 128): HEAD is detached, or the current
	branch has no upstream configured, or the configured upstream ref doesn't
	exist.  In that case, git has already printed the reason to stderr.
	"""
	# git resolves @{upstream} in repo_interpret_branch_name:
	# https://github.com/git/git/blob/0ffa3e35c7c82ab8d0de226149fb03b3f7674d05/object-name.c#L1471
	result = subprocess.run(
		["git", "merge-base", *options, "@{upstream}", "HEAD"],
		stdout=subprocess.PIPE, encoding="utf-8", check=False)
	if result.returncode == 1:
		return None
	if result.returncode == 128:
		raise UnknownUpstream("git could not resolve @{upstream}")
	result.check_returncode()
	commit = result.stdout.rstrip("\n")
	assert re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", commit), f"not a full commit hash: {commit!r}"
	return commit


def get_upstream_commit() -> str:
	"""
	Return the full hash of the upstream commit that HEAD is based on: the
	commit of the current branch's upstream branch (@{upstream}) that the
	branch was most recently rebased onto, for example by `git pull --rebase`.

	That commit isn't necessarily where @{upstream} points now: a fetch after
	the rebase can move @{upstream} to newer commits, or (if upstream was
	force-pushed) to commits that replace the one that HEAD is based on.  So
	first try `git merge-base --fork-point`, which also looks at the earlier
	values of @{upstream} in its reflog.  If that finds nothing (for example,
	because the reflog entry expired, or because the branch was based on a
	commit that was never the tip of @{upstream}), fall back to a best common
	ancestor of HEAD and @{upstream} (if there are several, git picks one).

	Raise UnknownUpstream if git can't resolve @{upstream}.  Raise
	NoCommonAncestor if HEAD and @{upstream} have no common ancestor in this
	repository (in a shallow clone, the common ancestor might just not have
	been fetched).
	"""
	commit = merge_base_with_upstream("--fork-point") or merge_base_with_upstream()
	if commit is None:
		raise NoCommonAncestor("HEAD and @{upstream} have no common ancestor")
	return commit


def pprint_table(out: TextIO, table: Sequence[Sequence[str]]) -> None:
	col_paddings = [max(map(len, cols)) for cols in zip(*table)]

	for row in table:
		for n, text in enumerate(row):
			col = text.ljust(col_paddings[n])
			print(col, end=" ", file=out)
		print("", file=out)


def mark_commits(args: argparse.Namespace) -> Iterator[tuple[str, str, str]]:
	t    = datetime.datetime.now()
	refs = get_refs()

	def with_message(commit: str) -> str:
		return get_commit_with_message(commit)

	if args.tag_upstream:
		try:
			upstream_commit = get_upstream_commit()
		except UnknownUpstream:
			current_branch = get_current_branch()
			if current_branch is None:
				print("Could not determine the upstream commit because HEAD is detached, so there is "
					"no current branch whose @{upstream} could be used.  If a rebase is in progress, "
					"finish it (`git rebase --continue`) or abort it (`git rebase --abort`) first; "
					"either one puts HEAD back on the branch that was being rebased.  Otherwise, "
					"check out the branch whose upstream commit you want to tag.", file=sys.stderr)
			else:
				print("Could not determine the upstream commit because git could not resolve @{upstream} "
					"(see git's error message above).  If the current branch has no upstream branch "
					"configured, you probably want to do something like:\n\n"
					f"git branch --set-upstream-to=origin/master {current_branch}\n"
					f"git config branch.{current_branch}.rebase true", file=sys.stderr)
			sys.exit(2)
		except NoCommonAncestor:
			print("Could not determine the upstream commit because HEAD and @{upstream} have no "
				"common ancestor.  If this is a shallow clone, the common ancestor might not have "
				"been fetched yet; `git fetch --deepen=<number of commits>` or "
				"`git fetch --unshallow` can fetch it.", file=sys.stderr)
			sys.exit(2)
		existing_tags_on_upstream = get_keys_for_value(refs.tags, upstream_commit)
		if any(get_re_for_format_string(args.tag_upstream).match(tag) for tag in existing_tags_on_upstream):
			yield (f"Already tagged with {existing_tags_on_upstream!r}:", "", with_message(upstream_commit))
		else:
			expanded_tag_upstream = get_expanded_name(args.tag_upstream, t, refs)
			subprocess.check_call(["git", "tag", expanded_tag_upstream, upstream_commit])
			yield (f"Created: {expanded_tag_upstream}", "->", with_message(upstream_commit))

	if args.tag_head:
		existing_tags_on_head = get_keys_for_value(refs.tags, refs.head)
		if any(get_re_for_format_string(args.tag_head).match(tag) for tag in existing_tags_on_head):
			yield (f"Already tagged with {existing_tags_on_head!r}:", "", with_message(refs.head))
		else:
			expanded_tag_head = get_expanded_name(args.tag_head, t, refs)
			subprocess.check_call(["git", "tag", expanded_tag_head])
			yield (f"Created: {expanded_tag_head}", "->", with_message(refs.head))

	if args.branch_head:
		branch_name = get_expanded_name(args.branch_head, t, refs)
		if refs.heads.get(branch_name) == refs.head:
			yield (f"Already branched as {branch_name}:", "", with_message(refs.head))
		else:
			subprocess.check_call(["git", "branch", "-f", branch_name])
			yield (f"Created: {branch_name}", "->", with_message(refs.head))


def main() -> None:
	parser = argparse.ArgumentParser(
		description="""
	Utility to mark the HEAD with a branch and timestamped tag, and the upstream
	commit (that we're rebased on top of) with another timestamped tag.  All three
	markings are optional.

	This allows you to

	1) easily find an older set of rebased patches
	2) see in tig/gitk which commits you've previously rebased onto.  This is
	   useful for seeing which new commits you might need to review.""",

		epilog="""
	For any of --tag-upstream, --tag-head, and --branch-head, you can use
	{YMDHMS} to insert the current time, or {YMDN} to insert the current date
	with a counter that avoids collision with existing tags.  Note that the {YMDHMS} or
	{YMDN} will not necessarily correspond on the HEAD and upstream commits.
	""")

	parser.add_argument("-u", "--tag-upstream", dest="tag_upstream",
		help="create a tag with this name pointing to the upstream commit")

	parser.add_argument("-t", "--tag-head", dest="tag_head",
		help="create a tag with this name pointing to HEAD")

	parser.add_argument("-b", "--branch-head", dest="branch_head",
		help="force-create a branch with this name pointing to HEAD")

	args = parser.parse_args()

	if not (args.tag_head or args.branch_head or args.tag_upstream):
		print("Must specify one or more of --tag-head, "
			"--branch-head, or --tag-upstream; see --help", file=sys.stderr)
		sys.exit(1)

	rows: list[tuple[str, str, str]] = []
	try:
		for output_message_row in mark_commits(args):
			rows.append(output_message_row)
	finally:
		pprint_table(sys.stdout, rows)


if __name__ == "__main__":
	main()
